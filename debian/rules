#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

%:
	dh $@

override_dh_auto_build:
	FREEDOMNAS_DOCS_VERSION=$(DEB_VERSION_UPSTREAM) mkdocs build --site-dir debian/site

override_dh_auto_clean:
	rm -rf debian/site

override_dh_install:
	mkdir -p debian/freedomnas-docs/usr/lib/freedomnas/docs
	cp -r debian/site/. debian/freedomnas-docs/usr/lib/freedomnas/docs/
